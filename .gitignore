# Secrets – never commit (design 2.3 rules)
.env
.env.*
!.env.example

# Server (Gradle)
server/build/
server/.gradle/
server/out/
server/bin/

# Client (Next.js)
client/node_modules/
client/.next/
client/out/
client/coverage/
client/next-env.d.ts

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
*.log

# Local tool settings
.claude/settings.local.json

# Personal notes (not part of the project)
/input

# Project documents – kept only on this computer from M01 on (not in the repository)
/doc/

# Terraform – state and plans hold secrets and stay out of Git (the lock file IS committed)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Terraform values that identify the AWS account (copy the *.example files)
deploy/terraform/**/backend.hcl
deploy/terraform/**/account.auto.tfvars
