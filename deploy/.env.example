# Copy to deploy/.env and fill in. deploy/.env is never committed (it holds secrets).

# Profile: local (laptop, seed data) | uat (seed data) | prod (live, no seed data)
SPRING_PROFILES_ACTIVE=local
APP_VERSION=local

# Database
POSTGRES_DB=thuhina
POSTGRES_USER=thuhina
POSTGRES_PASSWORD=change-me

# Login token signing secret – at least 32 random characters, different on every server.
# Example to generate one:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-32-plus-characters

# Login cookie: false only for local http://localhost; true on UAT and production (HTTPS).
COOKIE_SECURE=false

# First start on an empty database (production): the first Admin, who must change this password at first login.
ADMIN_USERNAME=
ADMIN_TEMP_PASSWORD=

# JVM memory (design 16, risk 6)
JAVA_OPTS=-Xms256m -Xmx768m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError

# Ports on this computer
HTTP_PORT=80
API_PORT=8080
DB_PORT=5432
