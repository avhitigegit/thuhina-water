# UAT values (plan section 14). Nothing here is secret – passwords are generated by Terraform.

project    = "thuhina"
aws_region = "ap-southeast-2" # Sydney – the only region of the Free-plan project (D-U10)

# Fixed IPs that may open UAT (e.g. the client's office, "x.x.x.x/32").
# Your own changing IP is added with deploy/scripts/allow-my-ip.ps1, not here.
allowed_cidrs = []

alert_email        = "amritha.hitige@gmail.com"
monthly_budget_usd = 30

instance_type         = "t4g.small"
disk_size_gb          = 30
backup_retention_days = 7

# Plain settings written to the server's .env (secrets are generated in the module).
app_settings = {
  SPRING_PROFILES_ACTIVE = "uat"
  COOKIE_SECURE          = "true"
  POSTGRES_DB            = "thuhina"
  POSTGRES_USER          = "thuhina"
  JAVA_OPTS              = "-Xms256m -Xmx768m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError"
}
